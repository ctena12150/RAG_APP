# --- almacenamiento ---
RAG_STORE=postgres                # postgres | memory (memory = sin Postgres, solo pruebas/walking skeleton)
# Postgres con pgvector corre en un contenedor de tu VPS (deploy/docker-compose.yml)
DATABASE_DSN=postgresql://ragapp:cambia-esta-password@IP_VPS:5432/ragapp
# Dimensión del modelo de embeddings ACTIVO (inmutable por despliegue; cambiar ⇒ reindexar)
EMBEDDING_DIM=1024                # ollama bge-m3=1024 | google text-embedding-004=768

# --- proveedores ---
GROQ_API_KEY=
MISTRAL_API_KEY=                  # opcional: fallback a nivel de proveedor

# --- embeddings: contenedor Ollama en tu VPS (default) ---
# Arranque lado VPS: cd deploy && docker compose up -d
# Descarga del modelo (una vez): docker exec rag-ollama ollama pull bge-m3
# Verificación: curl http://IP_VPS:11434/api/tags
OLLAMA_BASE_URL=http://IP_VPS:11434/v1
# Alternativa sin abrir puertos: túnel SSH doble desde local
#   ssh -L 5432:localhost:5432 -L 11434:localhost:11434 <vps>
# …y usa http://localhost:11434/v1 y localhost:5432 en las URLs/DSN.

# --- embeddings: alternativa cloud gratuita (Google AI Studio) ---
# Descomenta estas dos líneas y ajusta EMBEDDING_DIM=768 para usar Google en vez de Ollama.
# GOOGLE_API_KEY=
# EMBEDDINGS_CHAIN=google:text-embedding-004

# Fallback local en el mismo servidor: instalar con `docker exec rag-ollama ollama pull qwen3:8b`
GENERATION_CHAIN=groq:openai/gpt-oss-120b,ollama:qwen3:8b
UTILITY_CHAIN=groq:openai/gpt-oss-20b,ollama:qwen3:8b
PLANNER_CHAIN=

# --- pipeline (todos opcionales; valores por defecto en app/config.py) ---
ENABLE_AGENTIC_MODE=true
ENABLE_SELF_VERIFICATION=true
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true

# --- caché semántica de consultas (solo primera pregunta de conversación) ---
ENABLE_CACHE_CONSULTAS=true
CACHE_UMBRAL_SIMILITUD=0.95        # coseno mínimo para servir una respuesta cacheada
CACHE_MAX_ENTRADAS=128             # LRU en memoria del proceso
CACHE_TTL_MINUTOS=60               # además se invalida al ingestar/borrar documentos

# --- arranque ---
ENABLE_WARMUP=true                 # ping BD + embedding dummy al arrancar

# --- seguridad ---
INTERNAL_API_KEY=dev-internal-key # debe coincidir con Security:InternalApiKey del backend .NET

# --- guardrails ---
GUARDRAIL_UMBRAL_RELEVANCIA=0.25   # confianza mínima 0..1; <=0 desactiva
GUARDRAIL_VERIFICAR_DATOS=true     # cifras de la respuesta deben existir en las fuentes
GUARDRAIL_EXIGIR_CITAS=true        # con fuentes, la respuesta debe citar alguna
