# ============================================================
# Evidentia·RAG — variables del stack completo (deploy/.env)
# Copia en la VPS:  cp deploy/.env.example deploy/.env
# ============================================================

# --- obligatorias ---
# Contraseña del Postgres. NO uses ; : / @ # (romperían DSN y connection string).
POSTGRES_PASSWORD=RagTest2026-1234
# Clave interna servicio-a-servicio (.NET → Python, header X-Internal-Key). Genera una:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=cambia-esta-clave-interna

# --- proveedores LLM ---
GROQ_API_KEY=
MISTRAL_API_KEY=                  # opcional: fallback a nivel de proveedor

# --- embeddings ---
# bge-m3 (Ollama en la VPS, 1024d, defecto) | google:text-embedding-004 (AI Studio, 768d)
EMBEDDING_DIM=1024
EMBEDDINGS_CHAIN=ollama:bge-m3
GOOGLE_API_KEY=                   # solo si EMBEDDINGS_CHAIN=google:text-embedding-004
# ⚠️ cambiar de modelo de embeddings exige vaciar documentos y reingestarlos

# --- cadenas de generación (defaults del servicio) ---
# En una VPS pequeña, deja solo Groq: el fallback ollama qwen3:8b pide ~6-8 GB de RAM.
# GENERATION_CHAIN=groq:openai/gpt-oss-120b
# UTILITY_CHAIN=groq:openai/gpt-oss-20b
# PLANNER_CHAIN=

# --- exposición ---
WEB_PORT=80
# Clave de acceso de la app (X-App-Access-Key); vacío = sin puerta extra. Si la
# defines, nginx la inyecta automáticamente en las peticiones del frontend.
APP_ACCESS_KEY=
ALLOWED_ORIGIN=*
ENABLE_WARMUP=true

